services:
  sub2api:
    build:
      args:
        VITE_MAGIC_RECIPES_URL: http://127.0.0.1:4178
        VITE_MAGIC_RECIPES_ORIGIN: http://127.0.0.1:4178
        VITE_MAGIC_STUDIO_URL: http://127.0.0.1:4179
    environment:
      CORS_ALLOWED_ORIGINS: http://127.0.0.1:4178,http://localhost:4178
  recipes:
    build:
      context: ../product-samples/magic-recipes/site
      dockerfile: Dockerfile
    image: mofamily-recipes:local
    ports:
      - "127.0.0.1:4178:4178"
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    restart: unless-stopped
